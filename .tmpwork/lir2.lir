func zeroed {
  entry:
    self = alloca
    size = alloca
    p = alloca
    store p, 0
    b = alloca
    %t0 = cast p
    store b, %t0
    i = alloca
    store i, 0
    br wh_cond0
  wh_cond0:
    %t1 = binop.7 i, size
